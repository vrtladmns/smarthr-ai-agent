# Copy this file to .env on the AWS instance and fill real values there.
# Do not commit the real .env file.

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=500
VOICE_MAX_UTTERANCE_SECONDS=300
VOICE_BARGE_IN_VERIFY_SECONDS=0.9
VOICE_BARGE_IN_CONFIDENCE=0.45
VOICE_BARGE_IN_MIN_WORDS=1
VOICE_BARGE_IN_COOLDOWN_SECONDS=0.7
RECRUITER_INTERVIEW_QUESTION_COUNT=2
RECRUITER_THINKING_SILENCE_SECONDS=3.5
RECRUITER_LONG_SILENCE_SECONDS=9
RECRUITER_MIN_ANSWER_SECONDS=1.0
RECRUITER_BROWSER_PROCESSING_NUDGE_MS=2000
RECRUITER_BROWSER_TTS_VOICE_HINTS=Jenny,Aria,Sonia,Natasha,Zira,Female
TTS_VOICE=en-US-JennyNeural
RECRUITER_INTERVIEW_PASS_SCORE=35
RECRUITER_INTERVIEW_HOLD_MIN_SCORE=25

LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AI Recruiter Agent
LANGCHAIN_API_KEY=your-langsmith-api-key

# Database: choose mssql or postgres.
DB_PROVIDER=mssql
MSSQL_CONNECTION_STRING=Server=your-sql-server; Database=your-db; User Id=your-user; Password=your-password; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;
MSSQL_ODBC_DRIVER=
MSSQL_LOGIN_TIMEOUT_SECONDS=60

# For PostgreSQL instead:
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database

# Mail provider: microsoft_graph is recommended for Outlook trigger deployment.
MAIL_PROVIDER=microsoft_graph
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_TENANT_ID=your-azure-tenant-id
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_MAILBOX=hr@example.com
ONEDRIVE_RECORDINGS_ENABLED=true
ONEDRIVE_RECORDINGS_USER=hr@example.com
ONEDRIVE_RECORDINGS_FOLDER=AI Recruiter Interview Recordings

# Optional future Teams AI interviewer bot.
# The current Python voice interviewer runs locally. To have the AI join a Teams
# meeting as a participant, create a Teams calling/meeting bot with Microsoft
# Graph Cloud Communications permissions and point its callback URL here.
TEAMS_AI_INTERVIEWER_ENABLED=false
TEAMS_AI_BOT_APP_ID=your-teams-bot-app-id
TEAMS_AI_BOT_DISPLAY_NAME=Virtual Admins AI Interviewer
TEAMS_AI_BOT_CALLBACK_URL=https://your-domain.com/teams/calls
TEAMS_AI_BOT_PUBLIC_MEDIA_BASE_URL=https://your-domain.com/media

GRAPH_WEBHOOK_HOST=0.0.0.0
GRAPH_WEBHOOK_PORT=8081
GRAPH_WEBHOOK_PATH=/graph/outlook
GRAPH_NOTIFICATION_URL=https://your-domain.com/graph/outlook
GRAPH_CLIENT_STATE=use-a-long-random-secret
GRAPH_SUBSCRIPTION_HOURS=48
GRAPH_PROCESSING_RETRY_SECONDS=120

RECRUITER_REPLY_ENABLED=true
RECRUITER_LOG_LEVEL=INFO
RECRUITER_LOG_FILE=logs/recruiter_agent.log
RECRUITER_POLL_LIMIT=10
RECRUITER_POLL_SECONDS=60
RECRUITER_HR_ESCALATION_EMAIL=raman.kumar@vertualadmins.com
RECRUITER_DASHBOARD_BASE_URL=http://127.0.0.1:8090
RECRUITER_INTERVIEW_BASE_URL=http://127.0.0.1:8090
RECRUITER_DASHBOARD_LOGIN_EMAIL=admin@example.com
RECRUITER_DASHBOARD_LOGIN_PASSWORD=change-this-password
RECRUITER_DASHBOARD_SESSION_SECRET=change-this-long-random-secret
RECRUITER_SCREENING_ATS_MIN=60
RECRUITER_SCREENING_JD_MIN=20
RECRUITER_OFFICE_LOCATION=Mohali
RECRUITER_WORK_SHIFT=night shift
RECRUITER_WORK_MODE=work from office
RECRUITER_WORKING_DAYS=5 days working
RECRUITER_CAB_FACILITY=available
RECRUITER_TIMEZONE=Asia/Kolkata
FINAL_HR_INTERVIEWERS=Pragati Pradhan <pragati.pradhan@virtualadmins.org>, Akash <akash@virtualadmins.org>
FINAL_HR_WINDOW_START_HOUR=18
FINAL_HR_WINDOW_END_HOUR=1
FINAL_HR_WORKDAYS=0,1,2,3,4
FINAL_HR_DEFAULT_DURATION_MINUTES=45

RECRUITER_APPEND_SIGNATURE=true
RECRUITER_SIGNATURE_SIGNOFF=Regards,
RECRUITER_SIGNATURE_NAME=HR Team
RECRUITER_SIGNATURE_COMPANY=Virtual Admins
RECRUITER_SIGNATURE_COMPANY_URL=https://virtualadmins.org
RECRUITER_SIGNATURE_EMAIL=career@virtualadmins.org
RECRUITER_SIGNATURE_LOGO_URL=https://virtualadmins.org/assets/images/logos/vaadmin-logo.png

# Original CV files are stored on disk. The saved path is written to
# recruiter_applications.attachment_filename; attachment_payload stays empty.
CV_STORAGE_DIR=storage/cvs
